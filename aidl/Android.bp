cc_binary {
    name: "android.hardware.biometrics.fingerprint-service.r5x",
    relative_install_path: "hw",
    init_rc: ["android.hardware.biometrics.fingerprint-service.r5x.rc"],
    vintf_fragments: ["android.hardware.biometrics.fingerprint-service.r5x.xml"],
    srcs: [
        "Fingerprint.cpp",
        "HealthMonitor.cpp",
        "LockoutTracker.cpp",
        "OppoFingerprint.cpp",
        "Session.cpp",
        "service.cpp",
    ],
    cflags: [
        "-DLOG_TAG=\"android.hardware.biometrics.fingerprint-service.r5x\"",
    ],
    header_libs: [
        "libhardware_headers",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libhidlbase",
        "liblog",
        "libutils",
        "android.hardware.biometrics.common-V4-ndk",
        "android.hardware.biometrics.fingerprint-V4-ndk",
        "vendor.oppo.hardware.biometrics.fingerprint@2.1",
    ],
    vendor: true,
}

cc_library_shared {
    name: "libcamera_reprocess_shim",
    srcs: ["reprocess_shim.cpp"],
    shared_libs: [
        "libcamera_metadata",
        "liblog",
    ],
    vendor: true,
    compile_multilib: "32",
}

cc_library_shared {
    name: "libarcsoft_refocus_shim",
    srcs: ["arcsoft_refocus_shim.cpp"],
    version_script: "arcsoft_refocus_shim.map",
    allow_undefined_symbols: true,
    vendor: true,
    compile_multilib: "32",
}
